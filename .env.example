# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# At least 32 random characters. Used to encrypt Spotify tokens in HttpOnly cookies.
SESSION_SECRET=replace-with-a-long-random-secret
# Keep true while designing without provider credentials. Real credentials automatically take precedence.
NEXT_PUBLIC_DEMO_MODE=true

# Spotify Web API (create an app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Add this exact URL to the Spotify app allowlist. Spotify rejects http://localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Vercel AI Gateway — Jev is called through AI SDK 7's evaluation API.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev

# DeepSeek v4.1 Flash on Modal (OpenAI-compatible endpoint)
DEEPSEEK_BASE_URL=https://umroo-aamir--ep-deepseek-v4-1-flash-server.us-west.modal.direct
# Only required if the Modal endpoint is protected.
MODAL_API_KEY=
# Set this to the exact model id your endpoint exposes if it validates model names.
DEEPSEEK_MODEL=deepseek-v4.1-flash

# Cloudflare Workers AI (server-side REST call)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default

# Convex local deployment. Run `npm run convex:dev` and copy the values it writes.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
