# Spotify OAuth (taste retrieval + playlist saving)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# Catalog search for visitors without a Spotify login defaults to the US market.
SPOTIFY_MARKET=US

# Encrypted session cookie
SESSION_SECRET=

# Convex (mix history + durable enrichment cache)
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
# Set the same random 32+ character value in Next.js and the Convex deployment.
CONVEX_SERVICE_SECRET=
# Set the public production origin here so auth redirects and SEO URLs use your live domain.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Public portfolio demo. Register each frontend hostname on the widget.
# Set TURNSTILE_HOSTNAMES per deployment; production must exclude local hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFCa58_992zWWOPd
TURNSTILE_HOSTNAMES=127.0.0.1,localhost
TURNSTILE_SECRET=

# Spotify access request owner notifications and requester confirmations (server only)
# Verify the sender domain in Resend before sending to real addresses.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Music Mixer <access@your-verified-domain.com>"
ACCESS_REQUEST_TO_EMAIL=

# Cloudflare Workers AI (GLM-4.7-Flash planning + cover generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default

# Groq (planner fallback + Whisper voice prompts)
GROQ_API_KEY=
GROQ_MODEL=

# Jev evaluation chain (OpenCode Zen first, official TypeSafe second)
OPENCODE_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13-free
JEV_OFFICIAL_MODEL=jev-1.13.0
JEV_LOGS=

# Track enrichment (ReccoBeats and MusicBrainz need no key)
# Last.fm powers community tags, vibe summaries, reference similarity, and tag definitions.
LASTFM_API_KEY=
# Optional custom User-Agent for MusicBrainz (its policy asks for a contact).
MUSICBRAINZ_AGENT=
# Optional cap on candidates enriched per run; default is no limit.
ENRICH_MAX_TRACKS=
