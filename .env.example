# Spotify OAuth (taste retrieval + playlist saving)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Encrypted session cookie
SESSION_SECRET=

# Convex (mix history + durable enrichment cache)
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Cloudflare Workers AI (GLM-4.7-Flash planning + cover generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default

# Groq (planner fallback)
GROQ_API_KEY=
GROQ_MODEL=

# Jev evaluation chain (OpenCode Zen first, official TypeSafe second)
OPENCODE_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13-free
JEV_OFFICIAL_MODEL=jev-1.13.0
JEV_LOGS=

# Track enrichment (ReccoBeats and MusicBrainz need no key)
# Last.fm powers community tags, vibe summaries, reference similarity, and tag definitions.
LASTFM_API_KEY=
# Optional custom User-Agent for MusicBrainz (its policy asks for a contact).
MUSICBRAINZ_AGENT=
# Optional cap on candidates enriched per run; default is no limit.
ENRICH_MAX_TRACKS=
