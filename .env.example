# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# At least 32 random characters. Used to encrypt Spotify tokens in HttpOnly cookies.
SESSION_SECRET=replace-with-a-long-random-secret
# Keep true while designing without provider credentials. Real credentials automatically take precedence.
NEXT_PUBLIC_DEMO_MODE=true

# Spotify Web API (create an app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Add this exact URL to the Spotify app allowlist. Spotify rejects http://localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Jev evaluation (TypeSafe System One).
# Primary: OpenCode Zen — get a key at https://opencode.ai/auth.
OPENCODE_API_KEY=
# Jev model on OpenCode Zen (free for a limited time).
JEV_MODEL=jev-1.13-free
# Fallback: official TypeSafe API (https://console.typesafe.ai), used when OpenCode fails.
TYPESAFE_API_KEY=
# Jev model on the official TypeSafe endpoint.
JEV_OFFICIAL_MODEL=jev-1.13.0
# Set to 1 to log exact Jev evaluation requests/responses to the server console.
JEV_LOGS=

# Planning LLM — primary Cloudflare Workers AI, fallback Groq (both OpenAI-compatible).
# Cloudflare model override; leave empty to use @cf/zai-org/glm-4.7-flash.
CLOUDFLARE_LLM_MODEL=
# Groq key from https://console.groq.com/keys; planning falls back to it when Cloudflare fails.
GROQ_API_KEY=
# Groq model override; leave empty to use openai/gpt-oss-120b.
GROQ_MODEL=

# Cloudflare Workers AI (server-side REST call; covers + planning LLM)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default

# Convex local deployment. Run `npm run convex:dev` and copy the values it writes.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
